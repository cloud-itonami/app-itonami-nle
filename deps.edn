{:paths ["src/main" "resources"] :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
                                          io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.html"}
        ;; jp-go-digital-design-system — デジタル庁デザインシステム(DADS)。
        ;; **このワークスペースの基本 design system**(オーナー判断 2026-08-05;
        ;; 実測 DADS 依存 170 repo / kotoba-ui 12 repo)。app CSS は `--hig-*`
        ;; トークン契約で書いてあり、jp-go-dds.tokens/bridge-css が DADS
        ;; primitive の上に再定義するので無改造で追従する。
        ;; fragment routing, shared with the other kami-app-* single-page apps
        io.github.kotoba-lang/route
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.route"}

        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}

 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"} reagent/reagent {:mvn/version "1.2.0"} thheller/shadow-cljs {:mvn/version "2.28.20"}}}
           :test {:extra-paths ["test"] :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}} :main-opts ["-m" "cognitect.test-runner"]}}}
